#!/bin/sh
# humemory — closes the open loops this commit purged.
#
# Enable in THIS repository:
#   git config core.hooksPath .githooks
#
# Enable in ANOTHER project: copy this file into its .githooks/ and export
# HUMEMORY_HOME pointing at your humemory checkout. Without it the script would
# be looked up inside the committed repository, where it does not exist — the
# database is shared across projects, the code is not.
#   export HUMEMORY_HOME=/path/to/humemory
#
# Only closes loops named explicitly ("Closes loop-a1b2c3d4"); the rest is
# suggested. Never fails: the commit is already written.

command -v bun >/dev/null 2>&1 || exit 0

HOME_DIR="${HUMEMORY_HOME:-$(git rev-parse --show-toplevel)}"
SCRIPT="$HOME_DIR/scripts/hook-post-commit.ts"

[ -f "$SCRIPT" ] || exit 0
bun "$SCRIPT" || true
