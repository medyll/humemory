{
  "name": "humemory",
  "version": "0.2.0",
  "description": "Memory for AI agents that forgets like a human — decaying traces, inverse search, and prospective loops that resurface on a cue",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "humemory": "./bin/humemory.js"
  },
  "files": [
    "dist",
    "bin",
    "public",
    ".githooks",
    "scripts/hook-session.ts",
    "scripts/hook-session-start.ts",
    "scripts/hook-post-commit.ts",
    "scripts/consolidate.js",
    "README.md",
    "AGENTS.md",
    "CHANGELOG.md",
    "docs",
    "LICENSE"
  ],
  "keywords": [
    "memory",
    "ai-agent",
    "llm",
    "claude",
    "forgetting-curve",
    "prospective-memory",
    "zeigarnik",
    "sqlite",
    "bun",
    "decay",
    "mcp"
  ],
  "author": "medyll",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/medyll/humemory.git"
  },
  "homepage": "https://github.com/medyll/humemory#readme",
  "bugs": {
    "url": "https://github.com/medyll/humemory/issues"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "scripts": {
    "dev": "bun run --watch src/cli/index.ts",
    "build": "tsc -p tsconfig.json && bun run build:web",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "start:api": "bun run src/api/server.ts",
    "cli": "bun run src/cli/index.ts",
    "consolidate": "bun run scripts/consolidate.js",
    "dream": "bun run src/cli/index.ts dream",
    "mcp": "bun run src/mcp/server.ts",
    "build:web": "node -e \"require('fs').rmSync('public/app',{recursive:true,force:true})\" && bun build web/index.html --outdir public/app --production --splitting",
    "dev:web": "bun build web/index.html --outdir public/app --splitting --watch",
    "typecheck:web": "tsc -p web/tsconfig.json",
    "clean:web": "node -e \"require('fs').rmSync('public/app',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.92.0",
    "@hono/node-server": "^2.0.0",
    "@huggingface/transformers": "^4.2.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "commander": "^12.0.0",
    "d3": "^7.9.0",
    "flexsearch": "^0.7.43",
    "hono": "^4.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.184.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.11.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/d3": "^7.4.3",
    "@types/node": "^20.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.3",
    "bun-types": "^1.3.13",
    "js-yaml": "^5.1.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  }
}
