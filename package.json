{
  "name": "humemory",
  "version": "0.1.0",
  "description": "Human-like memory system with progressive degradation and inverse search",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "humemory": "./bin/humemory.js"
  },
  "scripts": {
    "dev": "bun run --watch src/cli/index.ts",
    "build": "tsc -p tsconfig.json && bun run build:web",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "start:api": "bun run src/api/server.ts",
    "cli": "bun run src/cli/index.ts",
    "consolidate": "bun run scripts/consolidate.js",
    "build:web": "bun build web/index.html --outdir public/app --production --splitting",
    "dev:web": "bun build web/index.html --outdir public/app --splitting --watch",
    "typecheck:web": "tsc -p web/tsconfig.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.92.0",
    "@hono/node-server": "^2.0.0",
    "commander": "^12.0.0",
    "d3": "^7.9.0",
    "flexsearch": "^0.7.43",
    "hono": "^4.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.11.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/d3": "^7.4.3",
    "@types/node": "^20.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.3",
    "bun-types": "^1.3.13",
    "js-yaml": "^5.1.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  }
}
